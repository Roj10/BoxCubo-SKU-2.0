# Copie para frontend/.env e preencha. O .env não vai para o git.

# Nomes da equipe (aparecem nas listas de "quem fez"), separados por vírgula
VITE_EQUIPE=Nome1,Nome2,Nome3

# Rodapé do PDF da Ordem de Produção: linhas separadas por "|"
VITE_EMPRESA_RODAPE=CNPJ: 00.000.000/0001-00|IE: 000.000.000|Endereço da empresa|Cidade - UF, 00000-000
